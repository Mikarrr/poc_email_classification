# Local LLM (Ollama). Inside docker compose use http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0

# Outgoing mail (Mailpit). Inside docker compose use SMTP_HOST=mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TIMEOUT_SECONDS=10
MAIL_FROM=router@example.com

LOG_LEVEL=INFO

# docker compose only: host ports and CPU threads for Ollama (default: half of the cores)
API_PORT=8000
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
OLLAMA_NUM_THREAD=
